{
  "name": "grok2api",
  "private": true,
  "type": "module",
  "author": "Xchat1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xchat1/grok2api.git"
  },
  "homepage": "https://github.com/Xchat1/grok2api",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "ensure-cf": "python3 scripts/ensure_cf_resources.py",
    "deploy:cf": "npm run ensure-cf && npx wrangler d1 migrations apply DB --remote --config wrangler.ci.toml && npx wrangler deploy --config wrangler.ci.toml",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260124.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.61.0"
  }
}

